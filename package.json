{
  "name": "video-chat-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based group video chat room",
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names client,server --prefix-colors cyan,magenta \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "lint": "npm run lint:tests && npm run lint --workspaces --if-present",
    "lint:tests": "eslint tests playwright.config.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:browser",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:unit:coverage": "npm run test:unit:coverage --workspaces --if-present",
    "test:integration": "vitest run --config tests/vitest.integration.config.js",
    "test:browser": "playwright test",
    "test:soak": "node --expose-gc scripts/run-socket-soak.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "socket.io-client": "^4.8.1",
    "vitest": "^3.2.4"
  }
}
